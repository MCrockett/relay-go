#!/usr/bin/env python3.11
"""relay: idea -> spec -> plan -> build, each stage reviewed by the other provider."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))  # repo root, above bin/
# The status line has a 150 ms budget, including waiting up to 100 ms for the sample lock.
if sys.argv[1:] == ["usage-snapshot", "claude"]:
    from relaylib.usage import capture_claude
    sys.exit(capture_claude(sys.stdin))
# Agent hooks: silent, always exit 0, stdlib only (session-health R1).
if len(sys.argv) == 3 and sys.argv[1] == "hook" and sys.argv[2] in ("claude", "codex"):
    try:
        from relaylib.sessions import capture
        capture(sys.argv[2], sys.stdin)
    except Exception:
        pass
    sys.exit(0)
from relaylib.commands import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
